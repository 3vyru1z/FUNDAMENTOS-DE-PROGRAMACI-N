Algoritmo sistema_gestion_proyectos

Definir proyectos_registrados como una cadena
Definir matriz_proyectos como una cadena
Definir archivo_proyectos como una cadena
Definir archivo_matriz como una cadena

archivo_proyectos <-- "proyectos_guardados.txt"
archivo_matriz <-- "matriz_proyectos.txt"

SECCION 1: FUNCIONES AUXILIARES Y MATEMATICAS

1.1 SubProceso calcular_restante (inicial, gastado)
    Retornar inicial - gastado
FinSubProceso

1.4 SubProceso calcular_porcentaje (cumplidas, total)
    Retornar (cumplidas / total) * 100
FinSubProceso

1.7 SubProceso calcular_semanas (dias)
    Retornar TRUNC(dias / 7)
FinSubProceso

1.10 SubProceso calcular_dias_sobrantes (dias, semanas)
    Retornar dias - (semanas * 7)
FinSubProceso

1.13 SubProceso generar_barra_progreso (porcentaje)
    Definir bloques como entero
    Si porcentaje < 0 Entonces
        porcentaje <-- 0
    FinSi
    Si porcentaje > 100 Entonces
        porcentaje <-- 100
    FinSi
    bloques <-- TRUNC(porcentaje / 10)
    Escribir "Progreso: [", bloques, " de 10 bloques completados]"
FinSubProceso

1.24 SubProceso evaluar_salud_presupuesto (inicial, gastado)
    Definir porcentaje_gastado como real
    Si inicial > 0 Entonces
        porcentaje_gastado <-- (gastado / inicial) * 100
    Sino
        porcentaje_gastado <-- 0
    FinSi
    Si porcentaje_gastado > 90 Entonces
        Escribir "Alerta: Presupuesto casi agotado (Mayor al 90%)"
    Sino
        Si porcentaje_gastado >= 70 Entonces
            Escribir "Precaucion: Presupuesto en riesgo moderado (Entre 70% y 90%)"
        Sino
            Escribir "Saludable: Presupuesto bajo control (Menor al 70%)"
        FinSi
    FinSi
FinSubProceso

SECCION 2: MODULO DE AUTENTICACION

2.1 SubProceso crear_cuenta()
    Definir nuevo_usuario, nueva_contrasena como una cadena
    Escribir "REGISTRO NUEVA CUENTA"
    Escribir "Ingrese un nombre de usuario:"
    Leer nuevo_usuario
    Escribir "Ingrese una contrasena:"
    Leer nueva_contrasena
    Si nuevo_usuario <> "" Y nueva_contrasena <> "" Entonces
        Escribir "Cuenta registrada con exito para: ", nuevo_usuario
    Sino
        Escribir "Error: Debe llenar todos los campos"
    FinSi
FinSubProceso

2.14 SubProceso iniciar_sesion()
    Definir usuario, contrasena como una cadena
    Escribir "INICIO DE SESION"
    Escribir "Ingrese su usuario:"
    Leer usuario
    Escribir "Ingrese contrasena:"
    Leer contrasena
    Si usuario <> "" Y contrasena <> "" Entonces
        Escribir "Bienvenido/a, ", usuario
    Sino
        Escribir "Datos incorrectos"
    FinSi
FinSubProceso

SECCION 3: REGISTRO Y METRICAS DE PROYECTOS

3.1 SubProceso registrar_proyecto()
    Definir nombre como una cadena
    Definir avance como real
    Definir continuar como una cadena
    Definir estado_inicial como una cadena
    continuar <-- "s"
    Mientras continuar = "s" O continuar = "S" Hacer
        Escribir "REGISTRO DE PROYECTO"
        Escribir "Nombre del proyecto:"
        Leer nombre
        Escribir "Porcentaje de avance (0 a 100):"
        Leer avance
        Si avance >= 0 Y avance <= 100 Entonces
            Escribir "Proyecto ", nombre, " registrado con ", avance, "% de avance"
            generar_barra_progreso(avance)
            Si avance = 100 Entonces
                estado_inicial <-- "Completado"
            Sino
                Si avance > 0 Entonces
                    estado_inicial <-- "En Proceso"
                Sino
                    estado_inicial <-- "Iniciado"
                FinSi
            FinSi
            AGREGAR_A_LISTA(proyectos_registrados, nombre + " - " + CONVERTIR_A_TEXTO(avance) + "%")
            AGREGAR_A_MATRIZ(matriz_proyectos, nombre, CONVERTIR_A_TEXTO(avance) + "%", estado_inicial)
        Sino
            Escribir "El porcentaje debe estar entre 0 y 100"
        FinSi
        Escribir "¿Desea registrar otro proyecto? (s/n):"
        Leer continuar
    FinMientras
FinSubProceso

3.34 SubProceso calcular_metricas()
    Definir nombre como una cadena
    Definir metas_total, metas_cumplidas como entero
    Definir presupuesto_inicial, presupuesto_gastado como real
    Definir dias, semanas, dias_s como entero
    Definir presupuesto_restante, porcentaje_avance como real
    Escribir "CALCULO DE METRICAS DE FINANZAS Y TIEMPO"
    Escribir "Nombre del proyecto:"
    Leer nombre
    Escribir "Total de metas:"
    Leer metas_total
    Escribir "Metas alcanzadas:"
    Leer metas_cumplidas
    Escribir "Presupuesto inicial:"
    Leer presupuesto_inicial
    Escribir "Presupuesto gastado:"
    Leer presupuesto_gastado
    Escribir "Duracion estimada en dias del proyecto:"
    Leer dias
    Si metas_total <= 0 Entonces
        Escribir "Error: Sus metas deben ser al menos 1"
    Sino
        presupuesto_restante <-- calcular_restante(presupuesto_inicial, presupuesto_gastado)
        porcentaje_avance <-- calcular_porcentaje(metas_cumplidas, metas_total)
        semanas <-- calcular_semanas(dias)
        dias_s <-- calcular_dias_sobrantes(dias, semanas)
        Escribir "RESUMEN DE RESULTADOS"
        Escribir "Resumen de metricas: ", nombre
        Escribir "Avance real de metas: ", porcentaje_avance, "%"
        generar_barra_progreso(porcentaje_avance)
        evaluar_salud_presupuesto(presupuesto_inicial, presupuesto_gastado)
        Escribir "Presupuesto disponible: $", presupuesto_restante
        Escribir "Tiempo estimado: ", semanas, " semanas y ", dias_s, " dias"
    FinSi
FinSubProceso

SECCION 4: LISTAS, MATRICES Y ANALISIS DE CADENAS

4.1 SubProceso ver_historial_proyectos()
    Escribir "HISTORIAL DE PROYECTOS REGISTRADOS"
    Si LONGITUD_LISTA(proyectos_registrados) = 0 Entonces
        Escribir "No hay proyectos registrados aun."
    Sino
        Para cada elemento en proyectos_registrados Hacer
            Escribir "- ", elemento
        FinPara
    FinSi
FinSubProceso

4.11 SubProceso calcular_estadisticas_lista()
    Definir total_elementos como entero
    Definir suma_avances, promedio_avance, mayor_avance, menor_avance, valor_actual como real
    Escribir "ESTADISTICAS GENERALES DE LA LISTA DE PROYECTOS"
    total_elementos <-- LONGITUD_LISTA(proyectos_registrados)
    Si total_elementos = 0 Entonces
        Escribir "La lista esta vacia."
    Sino
        suma_avances <-- 0
        mayor_avance <-- 0
        menor_avance <-- 100
        Para cada fila en matriz_proyectos Hacer
            valor_actual <-- CONVERTIR_A_NUMERO(QUITAR_CARACTER(fila[1], "%"))
            suma_avances <-- suma_avances + valor_actual
            Si valor_actual > mayor_avance Entonces
                mayor_avance <-- valor_actual
            FinSi
            Si valor_actual < menor_avance Entonces
                menor_avance <-- valor_actual
            FinSi
        FinPara
        promedio_avance <-- suma_avances / total_elementos
        Escribir "Cantidad total de proyectos en el arreglo: ", total_elementos
        Escribir "Promedio general de avance: ", promedio_avance, "%"
        Escribir "Mayor avance registrado: ", mayor_avance, "%"
        Escribir "Menor avance registrado: ", menor_avance, "%"
    FinSi
FinSubProceso

4.39 SubProceso ver_matriz_proyectos()
    Escribir "TABLA DE DATOS - MATRIZ DE PROYECTOS"
    Si LONGITUD_LISTA(matriz_proyectos) = 0 Entonces
        Escribir "No hay datos en la matriz de proyectos."
    Sino
        Para cada fila en matriz_proyectos Hacer
            Escribir "Proyecto: ", fila[0], " - Avance: ", fila[1], " - Estado: ", fila[2]
        FinPara
    FinSi
FinSubProceso

4.49 SubProceso actualizar_estados_matriz()
    Definir avance_num como real
    Escribir "ACTUALIZACION DE ESTADOS EN LOTE"
    Para cada fila en matriz_proyectos Hacer
        avance_num <-- CONVERTIR_A_NUMERO(QUITAR_CARACTER(fila[1], "%"))
        Si avance_num = 100 Entonces
            fila[2] <-- "Completado"
        Sino
            Si avance_num > 0 Entonces
                fila[2] <-- "En Proceso"
            Sino
                fila[2] <-- "Iniciado"
            FinSi
        FinSi
        Escribir "Proyecto: ", fila[0], " -> Estado actualizado: ", fila[2]
    FinPara
FinSubProceso

4.66 SubProceso resumen_conteo_matriz()
    Definir iniciados, en_proceso, completados como entero
    iniciados <-- 0
    en_proceso <-- 0
    completados <-- 0
    Escribir "RESUMEN Y CONTEO CRUZADO DE PROYECTOS"
    Para cada fila en matriz_proyectos Hacer
        Si fila[2] = "Iniciado" Entonces
            iniciados <-- iniciados + 1
        Sino
            Si fila[2] = "En Proceso" Entonces
                en_proceso <-- en_proceso + 1
            Sino
                Si fila[2] = "Completado" Entonces
                    completados <-- completados + 1
                FinSi
            FinSi
        FinSi
    FinPara
    Escribir "Total de registros: ", LONGITUD_LISTA(matriz_proyectos)
    Escribir "Iniciados: ", iniciados
    Escribir "En Proceso: ", en_proceso
    Escribir "Completados: ", completados
FinSubProceso

4.90 SubProceso buscar_analizar_cadenas()
    Definir palabra_clave como una cadena
    Definir encontrados como entero
    encontrados <-- 0
    Escribir "BUSQUEDA Y ANALISIS DE CADENAS EN PROYECTOS"
    Escribir "Ingrese una palabra clave para buscar:"
    Leer palabra_clave
    palabra_clave <-- MINUSCULAS(RECORTAR(palabra_clave))
    Para cada elemento en proyectos_registrados Hacer
        Si CONTIENE(MINUSCULAS(elemento), palabra_clave) Entonces
            encontrados <-- encontrados + 1
            Escribir "Coincidencia [", encontrados, "]: ", elemento
            Escribir "En mayusculas: ", MAYUSCULAS(elemento)
            Escribir "Total de caracteres: ", LONGITUD_CADENA(elemento)
        FinSi
    FinPara
    Si encontrados = 0 Entonces
        Escribir "No se encontraron proyectos con esa palabra."
    Sino
        Escribir "Total de coincidencias: ", encontrados
    FinSi
FinSubProceso

SECCION 5: MANEJO DE ARCHIVOS

5.1 SubProceso guardar_datos_archivos()
    Escribir "GUARDAR PROYECTOS Y MATRIZ EN ARCHIVO"
    ABRIR_ARCHIVO_ESCRITURA(archivo_proyectos)
    Para cada elemento en proyectos_registrados Hacer
        ESCRIBIR_LINEA(archivo_proyectos, elemento)
    FinPara
    CERRAR_ARCHIVO(archivo_proyectos)
    ABRIR_ARCHIVO_ESCRITURA(archivo_matriz)
    Para cada fila en matriz_proyectos Hacer
        ESCRIBIR_LINEA(archivo_matriz, fila[0] + "-" + fila[1] + "-" + fila[2])
    FinPara
    CERRAR_ARCHIVO(archivo_matriz)
    Escribir "Datos guardados en ", archivo_proyectos, " y ", archivo_matriz
FinSubProceso

5.15 SubProceso cargar_datos_archivos()
    Definir linea, linea_m como una cadena
    Definir campos como una cadena
    Escribir "CARGAR PROYECTOS Y MATRIZ DESDE ARCHIVO"
    Si EXISTE_ARCHIVO(archivo_proyectos) Entonces
        ABRIR_ARCHIVO_LECTURA(archivo_proyectos)
        LIMPIAR_LISTA(proyectos_registrados)
        Mientras NO FIN_ARCHIVO(archivo_proyectos) Hacer
            linea <-- RECORTAR(LEER_LINEA(archivo_proyectos))
            Si linea <> "" Entonces
                AGREGAR_A_LISTA(proyectos_registrados, linea)
            FinSi
        FinMientras
        CERRAR_ARCHIVO(archivo_proyectos)
        Si EXISTE_ARCHIVO(archivo_matriz) Entonces
            ABRIR_ARCHIVO_LECTURA(archivo_matriz)
            LIMPIAR_LISTA(matriz_proyectos)
            Mientras NO FIN_ARCHIVO(archivo_matriz) Hacer
                linea_m <-- RECORTAR(LEER_LINEA(archivo_matriz))
                Si linea_m <> "" Entonces
                    campos <-- DIVIDIR_TEXTO(linea_m, "-")
                    AGREGAR_A_MATRIZ(matriz_proyectos, campos[0], campos[1], campos[2])
                FinSi
            FinMientras
            CERRAR_ARCHIVO(archivo_matriz)
        FinSi
        Escribir "Proyectos y tabla cargados correctamente."
    Sino
        Escribir "No se encontro el archivo ", archivo_proyectos
    FinSi
FinSubProceso

SECCION 6: MENU Y FLUJO PRINCIPAL

6.1 SubProceso mostrar_menu()
    Escribir "SISTEMA DE GESTION DE PROYECTOS Y RESULTADOS"
    Escribir "1. Crear cuenta"
    Escribir "2. Iniciar sesion"
    Escribir "3. Registrar proyecto (Con ciclo)"
    Escribir "4. Calcular metricas de proyecto"
    Escribir "5. Ver historial de proyectos"
    Escribir "6. Ver estadisticas de la lista"
    Escribir "7. Ver matriz de proyectos en tabla"
    Escribir "8. Actualizar estados de proyectos en lote"
    Escribir "9. Ver resumen y conteo cruzado"
    Escribir "10. Buscar y analizar cadenas en proyectos"
    Escribir "11. Guardar proyectos en archivo"
    Escribir "12. Cargar proyectos desde archivo"
    Escribir "13. Salir"
FinSubProceso

6.17 SubProceso principal()
    Definir opcion como una cadena
    Definir ejecutando como logico
    ejecutando <-- Verdadero
    Mientras ejecutando Hacer
        mostrar_menu()
        Escribir "Selecciona una opcion (1 a 13):"
        Leer opcion
        Si opcion = "1" Entonces
            crear_cuenta()
        Sino
            Si opcion = "2" Entonces
                iniciar_sesion()
            Sino
                Si opcion = "3" Entonces
                    registrar_proyecto()
                Sino
                    Si opcion = "4" Entonces
                        calcular_metricas()
                    Sino
                        Si opcion = "5" Entonces
                            ver_historial_proyectos()
                        Sino
                            Si opcion = "6" Entonces
                                calcular_estadisticas_lista()
                            Sino
                                Si opcion = "7" Entonces
                                    ver_matriz_proyectos()
                                Sino
                                    Si opcion = "8" Entonces
                                        actualizar_estados_matriz()
                                        Escribir "Estados actualizados en lote correctamente!"
                                    Sino
                                        Si opcion = "9" Entonces
                                            resumen_conteo_matriz()
                                        Sino
                                            Si opcion = "10" Entonces
                                                buscar_analizar_cadenas()
                                            Sino
                                                Si opcion = "11" Entonces
                                                    guardar_datos_archivos()
                                                Sino
                                                    Si opcion = "12" Entonces
                                                        cargar_datos_archivos()
                                                    Sino
                                                        Si opcion = "13" Entonces
                                                            Escribir "Cerrando programa"
                                                            ejecutando <-- Falso
                                                        Sino
                                                            Escribir "Opcion no valida. Por favor escribe un numero del 1 al 13."
                                                        FinSi
                                                    FinSi
                                                FinSi
                                            FinSi
                                        FinSi
                                    FinSi
                                FinSi
                            FinSi
                        FinSi
                    FinSi
                FinSi
            FinSi
        FinSi
        Escribir "Presiona Enter para continuar"
        Leer opcion
    FinMientras
FinSubProceso

principal()

FinAlgoritmo

    principal()

FinAlgoritmo
